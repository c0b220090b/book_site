# このファイルを .env にコピーして値を入れてください
#   cp .env.example .env

# Google Books API キー（Google Cloud Console で取得）
GOOGLE_BOOKS_API_KEY=

# データベース（docker-compose.yml の db サービスと共通）
DB_HOST=db
DB_NAME=book_db
DB_USER=bookuser
DB_PASS=
MYSQL_ROOT_PASSWORD=

# Cloudflare Access
CF_TEAM_NAME=
CF_AUD_TAG=
APP_URL=https://example.com
